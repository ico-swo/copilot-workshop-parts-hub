{
  "name": "astra-parts-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Spare parts, suppliers and procurement service - GitHub Copilot workshop reference application",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
